#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &out OUT_BLE  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
                &kp N7   &kp KP_N8      &kp KP_N9        &kp KP_PLUS
                &kp KP_N4   &kp KP_N5      &kp KP_N6        &kp DELETE
                &kp KP_N1   &kp KP_N2      &kp KP_N3        &kp BACKSPACE
                &kp KP_N0   &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp KP_ENTER
            >;
        };
    };
};